#cloud-config
network:
  version: 1
  config:
    - type: physical
      name: eth0
      subnets:
        - type: static
          address: ${ip_address}
          gateway: ${gateway}
    - type: physical
      name: eth1
      subnets:
        - type: static
          address: ${ip_address_mgmt}
          gateway: ${gateway_mgmt}
    - type: nameserver
      interface: eth0
      address:
        - ${dns}
